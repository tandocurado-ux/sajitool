# Supabase（service_role キーはサーバー側でのみ使う。絶対に公開しない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# SOAX 住宅IPプロキシ
SOAX_USER=package-000000
SOAX_PASS=
SOAX_ENDPOINT=proxy.soax.com:5000

# SOAX のユーザー名に埋め込むオプション（既定値のままで動く）
# 例: package-000000-country-jp-region-aichi-sessionid-ab12cd34-sessionlength-600
SOAX_OPTION_SEPARATOR=-
SOAX_COUNTRY=jp
SOAX_REGION_OPTION=region
SOAX_SESSION_LENGTH=600

# 省略時は既定のインストール先から Google Chrome を探す
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
