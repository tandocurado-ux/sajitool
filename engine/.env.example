# Supabase（service_role キーはサーバー側でのみ使う。絶対に公開しない）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- SOAX 住宅IPプロキシ ---
# パッケージの識別はパスワード側で行われる。
# ユーザー名には package ID を入れず、オプション文字列だけを組み立てる:
#   country-jp-region-osaka-network-res-rotate-timed_300-session-<sessionid>
# これは engine/device.py が自動で組み立てるので、設定するのは以下だけ。
SOAX_PASS=
SOAX_ENDPOINT=proxy.soax.com:1337

# 地域指定。regions.prefecture（日本語）を英語小文字の region に変換して使う。
# 0 / false にすると region トークンを付けない（国だけで出る）。
SOAX_REGION_ENABLED=1

# --- Google だけ検知されるときの対処（既定は無効）---
# Google のときだけ使うプール。res=住宅 / mob=モバイル。
# 住宅IPで /sorry/ が続くときは mob に逃がす（要: パッケージで Mobile が有効）。
# 未設定なら SOAX_NETWORK に従う。モバイルは帯域単価が高いことがあるので注意。
SOAX_GOOGLE_NETWORK=res
# 1 にすると Google のときだけ region トークンを省いて country-jp だけで出る。
# 地点は geolocation override で決まるので順位への実害はない。
SOAX_GOOGLE_OMIT_REGION=0
# Google のときだけローテート間隔を変える（空なら SOAX_ROTATE_SECONDS を使う）
SOAX_GOOGLE_ROTATE_SECONDS=

# 以下は既定値のままで動く
SOAX_COUNTRY=jp
SOAX_NETWORK=res
SOAX_ROTATE_SECONDS=300
# session を固定したいときだけ設定する（英数字以外は自動で除去される）
# SOAX_SESSION_ID=

# --- スケジューラの実行間隔（秒）---
# 1検索ごとにこの範囲の一様ランダムで待つ。短くすると検知されやすくなる。
RUN_INTERVAL_MIN_SECONDS=60
RUN_INTERVAL_MAX_SECONDS=180
# キューに積む上限。1つの時刻枠で消化できる量に抑えるためのガード。
# 超えた分は積まずに捨てる（当日中の再実行はしない）。
QUEUE_MAX_ITEMS=60

# 異常検知の通知先（Slack / Discord の incoming webhook）。未設定ならログのみ。
# ALERT_WEBHOOK_URL=

# 省略時は既定のインストール先から Google Chrome を探す
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
